@model Gimnasio.Models.Usuario

@{
    ViewData["Title"] = "Detalle de Usuario";
    var suscripcionActiva = Model?.Suscripciones?
        .FirstOrDefault(s => s.activa && s.fecha_fin > DateTime.Now);
}

<header style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:var(--spacing-xl); width:100%; margin-top:70px;">
    <h1 style="color:#e5e2e1; margin:0;">Detalle de Usuario</h1>
</header>

<div class="d-flex justify-content-center">
    <div class="card" style="width:100%; max-width:700px;">

        @if (!string.IsNullOrEmpty(Model?.ruta_avatar))
        {
            <div class="d-flex justify-content-center mb-md">
                <img src="@Model.ruta_avatar"
                     style="width:120px; height:120px; border-radius:50%; object-fit:cover; border:3px solid var(--primary-fixed-dim);" />
            </div>
        }else
        {
            <div class="d-flex justify-content-center mb-md">
                <img id="preview-avatar" src="/uploads/defecto.webp" 
                style="width:80px; height:80px; border-radius:50%; object-fit:cover;" />
            </div>
        }

        <div class="row">
            <div class="col-md-6 mb-md">
                <div class="field-label">Nombre</div>
                <div style="color:#e5e2e1; font-size:16px;">@Model?.nombre</div>
            </div>

            <div class="col-md-6 mb-md">
                <div class="field-label">DNI</div>
                <div style="color:#e5e2e1; font-size:16px;">@Model?.dni</div>
            </div>

            <div class="col-md-6 mb-md">
                <div class="field-label">Rol</div>
                <span style="background:rgba(171,214,0,0.15); color:var(--primary-fixed-dim); padding:3px 12px; border-radius:999px; font-size:15px; font-weight:700;">
                    @Model?.RolNombre
                </span>
            </div>
            @if (Model?.rol == 2)
            {
                <div class="col-md-6 mb-md">
                    <div class="field-label">Suscripción</div>

                    @if (suscripcionActiva != null)
                    {
                        <div style="color:#e5e2e1; font-size:16px;">
                            <div><strong>Plan:</strong> @suscripcionActiva.Plan?.nombre</div>
                            <div><strong>Vence:</strong> @suscripcionActiva.fecha_fin.ToString("dd/MM/yyyy")</div>
                            <div>
                                <strong>Clases restantes:</strong>
                                @(suscripcionActiva.clases_restantes.HasValue
                                    ? suscripcionActiva.clases_restantes.Value.ToString()
                                    : "Pase libre")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="color:#ffb4ab; font-size:16px;">Sin suscripción activa</div>
                    }
                </div>
            }

            <div class="col-md-6 mb-md">
                <div class="field-label">Estado</div>
                @if (Model?.estado == true)
                {
                    <span style="background:rgba(171,214,0,0.15); color:#abd600; padding:3px 12px; border-radius:999px; font-size:15px; font-weight:700;">✓ Activo</span>
                }
                else
                {
                    <span style="background:rgba(255,180,171,0.15); color:#ffb4ab; padding:3px 12px; border-radius:999px; font-size:15px; font-weight:700;">✕ Inactivo</span>
                }
            </div>

            <div class="col-md-6">
                <div class="field-label">Fecha de Alta</div>
                <div style="color:#e5e2e1; font-size:16px;">@Model?.fecha_alta.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <div class="d-flex gap-3 justify-content-center mt-md">
            <a asp-action="Edit" asp-route-id="@Model?.id" class="btn-action btn-action-edit" style="padding:14px 28px; font-size:18px; min-width:140px; text-align:center;">Editar</a>
            <a asp-action="Index" asp-route-id="@Model?.id" class="btn-action btn-action-view" style="padding:14px 28px; font-size:18px; min-width:140px; text-align:center;">Volver</a>
        </div>

    </div>
</div>