@model Gimnasio.Models.Clase

@{
    ViewData["Title"] = "Editar";
}

<header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--spacing-xl); width: 100%; margin-top: 70px;">
    <h1 style="color: #e5e2e1; margin: 0;">Editar Clase</h1>
</header>

<div style="max-width: 600px; margin: 0 auto;">
    <form asp-action="Edit" style="background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: inset 1px 1px 0px rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 40px; font-family: 'Roboto', sans-serif;">
        
        <div asp-validation-summary="ModelOnly" style="background: rgba(255, 52, 48, 0.1); border-left: 4px solid #ffb4ab; color: #ffb4ab; padding: 16px; border-radius: 8px; margin-bottom: 24px; font-size: 14px;"></div>

        <input type="hidden" asp-for="id" />

        <!-- Nombre -->
        <div style="margin-bottom: 24px;">
            <label asp-for="nombre" style="display: block; font-size: 14px; font-weight: 700; color: #abd600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
                @Html.DisplayNameFor(model => model.nombre)
            </label>
            <input asp-for="nombre" style="width: 100%; padding: 12px 16px; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #e5e2e1; font-family: 'Roboto', sans-serif; font-size: 14px; transition: all 0.3s ease;" onfocus="this.style.borderColor='#abd600'; this.style.boxShadow='0 0 8px rgba(195, 244, 0, 0.2)'" onblur="this.style.borderColor='rgba(255, 255, 255, 0.1)'; this.style.boxShadow='none'" />
            <span asp-validation-for="nombre" style="color: #ffb4ab; font-size: 12px;"></span>
        </div>

        <!-- Descripción -->
        <div style="margin-bottom: 24px;">
            <label asp-for="descripcion" style="display: block; font-size: 14px; font-weight: 700; color: #abd600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
                @Html.DisplayNameFor(model => model.descripcion)
            </label>
            <input asp-for="descripcion" style="width: 100%; padding: 12px 16px; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #e5e2e1; font-family: 'Roboto', sans-serif; font-size: 14px; transition: all 0.3s ease;" onfocus="this.style.borderColor='#abd600'; this.style.boxShadow='0 0 8px rgba(195, 244, 0, 0.2)'" onblur="this.style.borderColor='rgba(255, 255, 255, 0.1)'; this.style.boxShadow='none'" />
            <span asp-validation-for="descripcion" style="color: #ffb4ab; font-size: 12px;"></span>
        </div>

        <!-- Días de la Semana -->
        <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 14px; font-weight: 700; color: #abd600; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.05em;">
                Días de la Semana
            </label>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                <label style="display: flex; align-items: center; cursor: pointer; padding: 8px; background: rgba(255, 255, 255, 0.02); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <input type="checkbox" name="dias" value="LUN" style="margin-right: 8px; cursor: pointer; width: 18px; height: 18px;" />
                    <span style="color: #e5e2e1; font-size: 14px;">Lunes</span>
                </label>
                <label style="display: flex; align-items: center; cursor: pointer; padding: 8px; background: rgba(255, 255, 255, 0.02); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <input type="checkbox" name="dias" value="MAR" style="margin-right: 8px; cursor: pointer; width: 18px; height: 18px;" />
                    <span style="color: #e5e2e1; font-size: 14px;">Martes</span>
                </label>
                <label style="display: flex; align-items: center; cursor: pointer; padding: 8px; background: rgba(255, 255, 255, 0.02); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <input type="checkbox" name="dias" value="MIE" style="margin-right: 8px; cursor: pointer; width: 18px; height: 18px;" />
                    <span style="color: #e5e2e1; font-size: 14px;">Miércoles</span>
                </label>
                <label style="display: flex; align-items: center; cursor: pointer; padding: 8px; background: rgba(255, 255, 255, 0.02); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <input type="checkbox" name="dias" value="JUE" style="margin-right: 8px; cursor: pointer; width: 18px; height: 18px;" />
                    <span style="color: #e5e2e1; font-size: 14px;">Jueves</span>
                </label>
                <label style="display: flex; align-items: center; cursor: pointer; padding: 8px; background: rgba(255, 255, 255, 0.02); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <input type="checkbox" name="dias" value="VIE" style="margin-right: 8px; cursor: pointer; width: 18px; height: 18px;" />
                    <span style="color: #e5e2e1; font-size: 14px;">Viernes</span>
                </label>
            </div>
            <input type="hidden" asp-for="dias_semana" id="diasSemanaHidden" />
            <span asp-validation-for="dias_semana" style="color: #ffb4ab; font-size: 12px;"></span>
        </div>

        <!-- Horario -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
            <div>
                <label asp-for="hora_inicio" style="display: block; font-size: 14px; font-weight: 700; color: #abd600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
                    Hora Inicio
                </label>
                <input asp-for="hora_inicio" type="time" style="width: 100%; padding: 12px 16px; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #e5e2e1; font-family: 'Roboto', sans-serif; font-size: 14px; transition: all 0.3s ease;" onfocus="this.style.borderColor='#abd600'; this.style.boxShadow='0 0 8px rgba(195, 244, 0, 0.2)'" onblur="this.style.borderColor='rgba(255, 255, 255, 0.1)'; this.style.boxShadow='none'" />
                <span asp-validation-for="hora_inicio" style="color: #ffb4ab; font-size: 12px;"></span>
            </div>
            <div>
                <label asp-for="hora_fin" style="display: block; font-size: 14px; font-weight: 700; color: #abd600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
                    Hora Fin
                </label>
                <input asp-for="hora_fin" type="time" style="width: 100%; padding: 12px 16px; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #e5e2e1; font-family: 'Roboto', sans-serif; font-size: 14px; transition: all 0.3s ease;" onfocus="this.style.borderColor='#abd600'; this.style.boxShadow='0 0 8px rgba(195, 244, 0, 0.2)'" onblur="this.style.borderColor='rgba(255, 255, 255, 0.1)'; this.style.boxShadow='none'" />
                <span asp-validation-for="hora_fin" style="color: #ffb4ab; font-size: 12px;"></span>
            </div>
        </div>

        <!-- Profesor -->
        <div style="margin-bottom: 24px;">
            <label asp-for="idprofesor" style="display: block; font-size: 14px; font-weight: 700; color: #abd600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
                @Html.DisplayNameFor(model => model.idprofesor)
            </label>
            <input asp-for="idprofesor" type="number" style="width: 100%; padding: 12px 16px; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #e5e2e1; font-family: 'Roboto', sans-serif; font-size: 14px; transition: all 0.3s ease;" onfocus="this.style.borderColor='#abd600'; this.style.boxShadow='0 0 8px rgba(195, 244, 0, 0.2)'" onblur="this.style.borderColor='rgba(255, 255, 255, 0.1)'; this.style.boxShadow='none'" />
            <span asp-validation-for="idprofesor" style="color: #ffb4ab; font-size: 12px;"></span>
        </div>

        <!-- Capacidad -->
        <div style="margin-bottom: 32px;">
            <label asp-for="capacidad" style="display: block; font-size: 14px; font-weight: 700; color: #abd600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
                @Html.DisplayNameFor(model => model.capacidad)
            </label>
            <input asp-for="capacidad" type="number" style="width: 100%; padding: 12px 16px; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #e5e2e1; font-family: 'Roboto', sans-serif; font-size: 14px; transition: all 0.3s ease;" onfocus="this.style.borderColor='#abd600'; this.style.boxShadow='0 0 8px rgba(195, 244, 0, 0.2)'" onblur="this.style.borderColor='rgba(255, 255, 255, 0.1)'; this.style.boxShadow='none'" />
            <span asp-validation-for="capacidad" style="color: #ffb4ab; font-size: 12px;"></span>
        </div>

        <!-- Botones -->
        <div style="display: flex; gap: 12px;">
            <button type="submit" style="flex: 1; background: #CCFF00; color: #283500; padding: 12px 24px; border: 1px solid #CCFF00; border-radius: 8px; font-weight: 700; font-family: 'Roboto', sans-serif; font-size: 14px; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='rgba(195, 244, 0, 0.9)'; this.style.transform='scale(1.02)'" onmouseout="this.style.backgroundColor='#CCFF00'; this.style.transform='scale(1)'">
                Guardar Cambios
            </button>
            <a asp-action="Index" style="flex: 1; background: rgba(255, 255, 255, 0.05); color: #abd600; padding: 12px 24px; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; font-weight: 700; font-family: 'Roboto', sans-serif; font-size: 14px; cursor: pointer; text-decoration: none; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='rgba(195, 244, 0, 0.08)'; this.style.transform='scale(1.02)'" onmouseout="this.style.backgroundColor='rgba(255, 255, 255, 0.05)'; this.style.transform='scale(1)'">
                Cancelar
            </a>
        </div>
    </form>
</div>

<script>
// Manejar los checkboxes de días
document.querySelectorAll('input[name="dias"]').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
        const selectedDays = Array.from(document.querySelectorAll('input[name="dias"]:checked'))
            .map(cb => cb.value)
            .join(',');
        document.getElementById('diasSemanaHidden').value = selectedDays;
    });
});
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
