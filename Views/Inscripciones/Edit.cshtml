@model Gimnasio.Models.Inscripcion

@{
    ViewData["Title"] = "Editar Inscripción";
}

<header style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:var(--spacing-xl); width:100%; margin-top:70px;">
    <h1 style="color:#e5e2e1; margin:0;">Editar Inscripción</h1>
    <a asp-action="Index" class="btn-action btn-action-view">← Volver</a>
</header>

<div class="card" style="max-width:520px;">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" style="color:var(--error); margin-bottom:var(--spacing-md); font-size:14px;"></div>
        <input type="hidden" asp-for="id" />

        <div class="form-group">
            <label>ID Usuario</label>
            <input asp-for="idusuario" />
            <span asp-validation-for="idusuario" style="color:var(--error); font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label>ID Clase</label>
            <input asp-for="idclase" />
            <span asp-validation-for="idclase" style="color:var(--error); font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label>Fecha</label>
            <input asp-for="fecha" type="date" />
            <span asp-validation-for="fecha" style="color:var(--error); font-size:12px;"></span>
        </div>

        <div style="display:flex; gap:12px; margin-top:var(--spacing-md);">
            <input type="submit" value="Actualizar" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}