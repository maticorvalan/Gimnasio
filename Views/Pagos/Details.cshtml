@model Gimnasio.Models.Pago

@{
    ViewData["Title"] = "Detalle de Pago";
}

<header style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:var(--spacing-xl); width:100%; margin-top:70px;">
    <h1 style="color:#e5e2e1; margin:0;">Detalle de Pago</h1>
    <a asp-action="Index" class="btn-action btn-action-view">← Volver</a>
</header>

<div class="card" style="max-width:520px;">

    <div style="display:flex; flex-direction:column; gap:var(--spacing-md);">

        <div style="border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:var(--spacing-md);">
            <div style="font-size:11px; font-weight:700; letter-spacing:0.05em; color:var(--primary-fixed-dim); text-transform:uppercase; margin-bottom:4px;">Usuario</div>
            <div style="color:#e5e2e1; font-size:16px;">@(Model.Usuario?.nombre ?? $"ID {Model.idusuario}")</div>
        </div>

        <div style="border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:var(--spacing-md);">
            <div style="font-size:11px; font-weight:700; letter-spacing:0.05em; color:var(--primary-fixed-dim); text-transform:uppercase; margin-bottom:4px;">Plan</div>
            <div style="color:#e5e2e1; font-size:16px;">@(Model.Suscripcion?.Plan?.nombre ?? "Sin plan asociado")</div>
        </div>

        <div style="border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:var(--spacing-md);">
            <div style="font-size:11px; font-weight:700; letter-spacing:0.05em; color:var(--primary-fixed-dim); text-transform:uppercase; margin-bottom:4px;">Suscripción</div>
            <div style="color:#e5e2e1; font-size:16px;">
                @if (Model.Suscripcion != null)
                {
                    <span>@Model.Suscripcion.fecha_inicio.ToString("dd/MM/yyyy") → @Model.Suscripcion.fecha_fin.ToString("dd/MM/yyyy")</span>
                }
                else
                {
                    <span style="color:var(--on-surface-variant); font-style:italic;">Sin suscripción asociada</span>
                }
            </div>
        </div>

        <div style="border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:var(--spacing-md);">
            <div style="font-size:11px; font-weight:700; letter-spacing:0.05em; color:var(--primary-fixed-dim); text-transform:uppercase; margin-bottom:4px;">Monto</div>
            <div style="color:var(--primary-fixed-dim); font-size:24px; font-weight:700;">$@Model.monto.ToString("N2")</div>
        </div>

        <div style="border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:var(--spacing-md);">
            <div style="font-size:11px; font-weight:700; letter-spacing:0.05em; color:var(--primary-fixed-dim); text-transform:uppercase; margin-bottom:4px;">Fecha de Pago</div>
            <div style="color:#e5e2e1; font-size:16px;">@Model.fecha_pago.ToString("dd/MM/yyyy")</div>
        </div>

        <div>
            <div style="font-size:11px; font-weight:700; letter-spacing:0.05em; color:var(--primary-fixed-dim); text-transform:uppercase; margin-bottom:4px;">Método de Pago</div>
            <div style="color:#e5e2e1; font-size:16px;">@Model.metodo_pago</div>
        </div>

    </div>

    <div style="display:flex; gap:12px; margin-top:var(--spacing-lg);">
        <a asp-action="Edit" asp-route-id="@Model.id" class="btn-action btn-action-edit">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.id" class="btn-action btn-action-delete">Eliminar</a>
    </div>

</div>