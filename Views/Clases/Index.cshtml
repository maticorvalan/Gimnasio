@model IEnumerable<Gimnasio.Models.Clase>

@{
    ViewData["Title"] = "Clases";
}

<header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--spacing-xl); width: 100%; margin-top: 70px;">
    <h1 style="color: #e5e2e1; margin: 0;">Gestión de Clases</h1>
    <a asp-action="Create" class="btn-header">Agregar Clase</a>
</header>

<div style="overflow-x: auto;">
<table class="data-table">
    <thead>
        <tr style="background: rgba(171, 214, 0, 0.1); border-bottom: 2px solid #abd600;">
            <th style="padding: 16px; text-align: left; color: #abd600; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">
                @Html.DisplayNameFor(model => model.nombre)
            </th>
            <th style="padding: 16px; text-align: left; color: #abd600; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">
                @Html.DisplayNameFor(model => model.descripcion)
            </th>
            <th style="padding: 16px; text-align: left; color: #abd600; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">
                Horario
            </th>
            <th style="padding: 16px; text-align: left; color: #abd600; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">
                Profesor
            </th>
            <th style="padding: 16px; text-align: left; color: #abd600; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">
                @Html.DisplayNameFor(model => model.capacidad)
            </th>
            <th style="padding: 16px; text-align: center; color: #abd600; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); transition: background 0.3s ease;" onmouseover="this.style.background='rgba(171, 214, 0, 0.05)'" onmouseout="this.style.background='transparent'">
            <td style="padding: 16px; color: #e5e2e1; font-size: 14px;">
                @Html.DisplayFor(modelItem => item.nombre)
            </td>
            <td style="padding: 16px; color: #e5e2e1; font-size: 14px;">
                @Html.DisplayFor(modelItem => item.descripcion)
            </td>
            <td style="padding: 16px; color: #e5e2e1; font-size: 14px;">
                <div style="color: #e5e2e1; margin-bottom: 4px;">
                    @Html.DisplayFor(modelItem => item.dias_semana)
                </div>
                <div style="color: #abd600; font-weight: 600; font-size: 12px;">
                    @item.hora_inicio.ToString("hh\\:mm") - @item.hora_fin.ToString("hh\\:mm")
                </div>
            </td>
            <td style="padding: 16px; color: #e5e2e1; font-size: 14px;">
                @Html.DisplayFor(modelItem => item.Profesor.nombre)
            </td>
            <td style="padding: 16px; color: #e5e2e1; font-size: 14px;">
                @Html.DisplayFor(modelItem => item.capacidad)
            </td>
            <td style="padding: 16px; text-align: center; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                <a asp-action="Edit" asp-route-id="@item.id" class="btn-action btn-action-edit">Editar</a>
                <a asp-action="Details" asp-route-id="@item.id" class="btn-action btn-action-view">Ver</a>
                <a asp-action="Delete" asp-route-id="@item.id" class="btn-action btn-action-delete">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
