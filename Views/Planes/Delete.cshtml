@model Gimnasio.Models.Plan

@{
    ViewData["Title"] = "Eliminar Plan";
}

<main style="width: 100%; max-width: 800px; margin: 0 auto; padding: 32px; margin-top: 70px;">
    <header style="margin-bottom: 40px;">
        <h1 style="color: #e5e2e1; margin: 0 0 8px 0;">Eliminar plan</h1>
        <p style="color: #ffb4ab; margin: 0; font-size: 14px;">Esta acción no se puede deshacer</p>
    </header>

    <section style="background: rgba(255, 180, 171, 0.1); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 2px solid rgba(255, 180, 171, 0.3); border-radius: 12px; padding: 32px; margin-bottom: 24px;">
        <h3 style="color: #ffb4ab; margin-top: 0;">¿Estás seguro de que deseas eliminar este plan?</h3>
        <p style="color: #e5e2e1; margin-bottom: 24px;">Esto eliminará permanentemente el plan <strong style="color: #abd600;">@Model.nombre</strong> y sus datos asociados.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; background: rgba(19, 19, 19, 0.5); padding: 16px; border-radius: 8px; margin-bottom: 24px;">
            <div>
                <p style="color: #abd600; font-size: 12px; text-transform: uppercase; font-weight: 700; margin: 0 0 8px 0; letter-spacing: 0.05em;">Nombre</p>
                <p style="color: #e5e2e1; font-size: 16px; font-weight: 700; margin: 0;">@Html.DisplayFor(model => model.nombre)</p>
            </div>
            <div>
                <p style="color: #abd600; font-size: 12px; text-transform: uppercase; font-weight: 700; margin: 0 0 8px 0; letter-spacing: 0.05em;">Precio</p>
                <p style="color: #CCFF00; font-size: 16px; font-weight: 700; margin: 0;">$@Html.DisplayFor(model => model.precio)</p>
            </div>
        </div>
    </section>

    <form asp-action="Delete" style="margin-bottom: 24px;">
        <input type="hidden" asp-for="id" />
        <div style="display: flex; gap: 12px;">
            <button type="submit" style="flex: 1; padding: 12px 24px; background: #ffb4ab; color: #131313; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.background='#ff9999'; this.style.transform='scale(1.02)'" onmouseout="this.style.background='#ffb4ab'; this.style.transform='scale(1)'">Eliminar Plan</button>
            <a href="/Planes" style="flex: 1; text-align: center; padding: 12px 24px; background: rgba(255, 255, 255, 0.1); color: #e5e2e1; border: 1px solid rgba(171, 214, 0, 0.3); border-radius: 8px; font-weight: 700; cursor: pointer; text-decoration: none; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center;" onmouseover="this.style.background='rgba(171, 214, 0, 0.2)'; this.style.borderColor='#abd600'" onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='rgba(171, 214, 0, 0.3)'">Cancelar</a>
        </div>
    </form>
</main>
